  "aboutTitle": {
    "message": "Über E-Mail-Ablauf-Manager",
    "description": "Titel des Über-Abschnitts"
  },
  "aboutInitiativeTitle": {
    "message": "🌱 Die Expires-Header-Initiative",
    "description": "Titel des Initiativ-Unterabschnitts"
  },
  "aboutInitiativeText": {
    "message": "Der \"Expires\"-E-Mail-Header ist Teil einer umfassenderen Umweltinitiative zur Reduzierung des CO2-Fußabdrucks der E-Mail-Speicherung. Rechenzentren, die weltweit Milliarden von E-Mails speichern, verbrauchen enorme Mengen an Energie. Viele E-Mails haben ein natürliches Ablaufdatum, werden aber auf unbestimmte Zeit gespeichert und verbrauchen unnötig Ressourcen.",
    "description": "Beschreibung der Initiative"
  },
  "aboutZeroCarbonTitle": {
    "message": "Zero Carbon Email",
    "description": "Titel des Zero Carbon-Abschnitts"
  },
  "aboutZeroCarbonText": {
    "message": "Die Zero Carbon Email-Initiative bringt E-Mail-Dienstanbieter, Softwareanbieter und Umweltschützer zusammen, um dieses Problem anzugehen. Durch die Einführung eines standardisierten \"Expires\"-Headers können E-Mail-Absender angeben, wann ihre Nachrichten nicht mehr benötigt werden.",
    "description": "Beschreibung von Zero Carbon"
  },
  "aboutStandardizationTitle": {
    "message": "Standardisierung (IETF RFC)",
    "description": "Titel des Standardisierungsabschnitts"
  },
  "aboutStandardizationText": {
    "message": "Der \"Expires\"-Header wird derzeit durch die Internet Engineering Task Force (IETF) standardisiert. Der Entwurfsspezifikation: draft-ietf-mailmaint-expires",
    "description": "Beschreibung der Standardisierung"
  },
  "aboutExtensionTitle": {
    "message": "Rolle dieser Erweiterung",
    "description": "Titel des Erweiterungsrollen-Abschnitts"
  },
  "aboutExtensionText": {
    "message": "E-Mail-Ablauf-Manager implementiert diesen aufkommenden Standard in Thunderbird und ermöglicht Ihnen, E-Mails automatisch gemäß der vom Absender definierten Ablaufdaten zu verarbeiten. Durch die Verwendung dieser Erweiterung tragen Sie dazu bei, E-Mail umweltfreundlicher zu gestalten.",
    "description": "Beschreibung der Erweiterungsrolle"
  },
